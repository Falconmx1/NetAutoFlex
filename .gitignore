# ==============================================
# NetAutoFlex - .gitignore
# Para proyectos de automatización de red en Windows/Linux
# ==============================================

# ==============================================
# LOGS Y ARCHIVOS TEMPORALES
# ==============================================

# Logs generados por NetAutoFlex
logs/
*.log
*.log.*
log_*.txt
netautoflex_*.log
*_debug.log

# Archivos temporales
*.tmp
*.temp
*.swp
*.swo
*~
temp/
tmp/
*.bak
*.backup
*.cache

# ==============================================
# ARCHIVOS DEL SISTEMA (WINDOWS)
# ==============================================

# Windows thumbnail cache
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Windows desktop.ini
desktop.ini

# Windows recycle bin
$RECYCLE.BIN/

# Windows installers
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# ==============================================
# ARCHIVOS DEL SISTEMA (LINUX/MAC)
# ==============================================

# Linux
.directory
*.pid
*.socket
*.so
*.dylib

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db

# ==============================================
# ARCHIVOS DE DEPENDENCIAS Y PAQUETES
# ==============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# PowerShell modules
*.psd1
*.psm1
packages/
module/
*.nupkg

# ==============================================
# ARCHIVOS DE CONFIGURACIÓN LOCAL
# ==============================================

# Configuración personal
config.local
*.local
.env
.env.local
.secrets
*.secret
config.ini
settings.local.*

# Credenciales
*_key.pem
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
.credentials

# ==============================================
# ARCHIVOS DE EDICIÓN Y DESARROLLO
# ==============================================

# Editores
.vscode/
.idea/
*.sublime-*
.project
.classpath
.settings/
*.code-workspace

# ==============================================
# ARCHIVOS DE PRUEBAS Y RESULTADOS
# ==============================================

# Pruebas de red
scan_results_*.txt
nmap_scan_*.xml
arp_scan_*.txt
ping_sweep_*.csv
port_scan_*.json
bandwidth_test_*.json

# Capturas de tráfico
*.pcap
*.pcapng
*.cap
capture_*.pcap

# ==============================================
# BACKUPS Y COMPRIMIDOS
# ==============================================

# Backups
*.bak
*.backup
*.old
*.orig

# Comprimidos
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ==============================================
# ARCHIVOS ESPECÍFICOS DEL PROYECTO
# ==============================================

# Posibles archivos grandes de test
test_files/
test_data/
*.iso
*.img
*.vmdk
*.vhd

# Reportes generados
reports/
report_*.html
report_*.pdf
network_audit_*.csv

# ==============================================
# EXCEPCIONES (lo que SÍ se debe incluir)
# ==============================================

# NO ignorar los logs de ejemplo (si existen)
!logs/example.log
!*.example.log

# NO ignorar archivos de configuración de ejemplo
!*.example
!config.example.ini

# NO ignorar READMEs y documentación
!README.md
!CONTRIBUTING.md
!CHANGELOG.md

# ==============================================
# OTROS ARCHIVOS TEMPORALES
# ==============================================

# Core dumps
core.*
*.core

# Archivos de sesión
session_*
*.session

# Archivos lock
*.lock
.lock
package-lock.json (si usas Node)

# ==============================================
# ARCHIVOS DE LOG DE HERRAMIENTAS EXTERNAS
# ==============================================

# iperf3 logs
iperf3_*.log
client_*.json
server_*.json

# nmap logs
nmap_*.log
*.nmap
*.gnmap
*.xml

# traceroute logs
traceroute_*.log
trace_*.txt

# ==============================================
# FINAL
# ==============================================
